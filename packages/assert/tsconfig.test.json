{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    // At the base config's `esnext`, an `accessor` field is emitted as one,
    // which no released Node.js can parse. The decorator tests declare them.
    "target": "es2022",
    "rootDir": ".",
    "outDir": "test-dist",
    "resolveJsonModule": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src", "test"],
  "exclude": ["test/fixtures"]
}
