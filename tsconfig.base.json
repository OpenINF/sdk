{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "declaration": true,
    "declarationMap": true,
    // No enums, namespaces or parameter properties: only syntax that erases to
    // the JavaScript beside it. An enum compiles to quoted writes read back
    // unquoted, which a property-renaming minifier such as Closure Compiler's
    // ADVANCED mode breaks, and Node.js's type stripping cannot run one.
    "erasableSyntaxOnly": true,
    "esModuleInterop": true,
    "exactOptionalPropertyTypes": true,
    // Standard decorators. The `Assert` decorator @openinf/assert ships is an
    // auto-accessor decorator, which the legacy implementation has no form of.
    "experimentalDecorators": false,
    "forceConsistentCasingInFileNames": true,
    "lib": ["esnext"],
    "module": "commonjs",
    "moduleResolution": "bundler",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "pretty": true,
    "sourceMap": true,
    "strict": true,
    "strictNullChecks": true,
    "target": "esnext",
    "typeRoots": ["node_modules/@types"],
    "types": ["node"],
    "useDefineForClassFields": true
  }
}
