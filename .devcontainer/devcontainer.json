// For format details, see https://aka.ms/devcontainer.json. For config options,
// see https://containers.dev.
{
  "name": "OpenINF SDK",

  // A stock image plus features. The Dockerfile beside this file adds only
  // what has no feature worth using -- fish and ripgrep, both of which trixie
  // packages itself.
  "build": {
    "dockerfile": "Dockerfile"
  },

  // No Node version here on purpose: it lives in .nvmrc, which nvm.fish reads
  // directly and post-create.sh hands to the image's nvm.
  "features": {
    // pnpm self-manages to the version a repository asks for, so any recent
    // release is enough to bootstrap.
    "ghcr.io/devcontainers-extra/features/pnpm:2": {},
    // Binary only -- `gh` keeps its own credentials, so a first use still
    // wants `gh auth login`.
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // `http-server`, behind `pnpm run docs:serve`, serves the generated
  // documentation on 8080.
  "forwardPorts": [8080],

  // So oxlint, prettier, cspell, knip and typedoc work when typed directly,
  // not only under `pnpm exec`, and for every caller rather than fish alone.
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/node_modules/.bin:${containerEnv:PATH}"
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  // Unlike postCreateCommand, this runs on every attach. Forwarded agent
  // sockets are per-session, so anything depending on one belongs there.
  "postStartCommand": "bash .devcontainer/post-start.sh",

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.profiles.linux": {
          "fish": {
            "path": "fish"
          }
        },
        "terminal.integrated.defaultProfile.linux": "fish",

        // Todo Tree never consults PATH, so the binary alone is not enough;
        // see the Dockerfile. Here rather than .vscode/settings.json because
        // it is a container path, and wrong anywhere else.
        "todo-tree.ripgrep.ripgrep": "/usr/bin/rg"
      },
      // Kept in step with .vscode/extensions.json, which recommends these to
      // anyone opening the repository. Listing them here installs them.
      "extensions": [
        // https://marketplace.visualstudio.com/items?itemName=aaron-bond.better-comments
        "aaron-bond.better-comments",
        // https://marketplace.visualstudio.com/items?itemName=christian-kohler.npm-intellisense
        "christian-kohler.npm-intellisense",
        // https://marketplace.visualstudio.com/items?itemName=christian-kohler.path-intellisense
        "christian-kohler.path-intellisense",
        // https://marketplace.visualstudio.com/items?itemName=DavidAnson.vscode-markdownlint
        "davidanson.vscode-markdownlint",
        // https://marketplace.visualstudio.com/items?itemName=eamodio.gitlens
        "eamodio.gitlens",
        // https://marketplace.visualstudio.com/items?itemName=editorconfig.editorconfig
        "editorconfig.editorconfig",
        // https://marketplace.visualstudio.com/items?itemName=esbenp.prettier-vscode
        "esbenp.prettier-vscode",
        // https://marketplace.visualstudio.com/items?itemName=fknop.vscode-npm
        "fknop.vscode-npm",
        // https://marketplace.visualstudio.com/items?itemName=Gruntfuggly.todo-tree
        "Gruntfuggly.todo-tree",
        // https://marketplace.visualstudio.com/items?itemName=ionutvmi.path-autocomplete
        "ionutvmi.path-autocomplete",
        // https://marketplace.visualstudio.com/items?itemName=mrmlnc.vscode-json5
        "mrmlnc.vscode-json5",
        // https://marketplace.visualstudio.com/items?itemName=oxc.oxc-vscode
        "oxc.oxc-vscode",
        // https://marketplace.visualstudio.com/items?itemName=redhat.vscode-yaml
        "redhat.vscode-yaml",
        // https://marketplace.visualstudio.com/items?itemName=streetsidesoftware.code-spell-checker
        "streetsidesoftware.code-spell-checker",
        // https://marketplace.visualstudio.com/items?itemName=travisthetechie.write-good-linter
        "travisthetechie.write-good-linter",
        // https://marketplace.visualstudio.com/items?itemName=yzhang.markdown-all-in-one
        "yzhang.markdown-all-in-one"
      ]
    }
  },

  "remoteUser": "node"
}
