{
  "name": "root",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "docs:artifact": "node tools/build-api-artifact.js",
    "docs:build": "pnpm run build && pnpm run docs:generate",
    "docs:check": "node tools/check-api-docs.js",
    "docs:generate": "typedoc",
    "docs:serve": "http-server -c-1 -o docs/api/",
    "format": "prettier --write .",
    "land": "node build/tasks/land-pull-request.mts",
    "lint": "pnpm -r run lint && pnpm run lint:guards && pnpm run lint:categories",
    "lint:categories": "node tools/check-api-categories.mts",
    "lint:commits": "node build/tasks/verify/verify-commits.mts",
    "lint:examples": "node tools/check-readme-examples.js",
    "lint:guards": "node tools/check-guard-expectations.mts",
    "lint:format": "prettier --check .",
    "lint:knip": "knip --no-progress",
    "lint:md": "rc=0; markdownlint-cli2 || rc=1; remark --frail --silently-ignore --quiet . || rc=1; node tools/check-jsdoc-markdown.mts || rc=1; exit $rc",
    "lint:packages": "node tools/check-package-quality.js",
    "lint:spelling": "cspell --no-progress",
    "lint:types": "tsc -p tsconfig.tools.json",
    "release": "pnpm -r publish --no-git-checks --provenance",
    "sync-metadata": "node tools/sync-package-metadata.js",
    "test": "pnpm -r run test && pnpm run test:queue && pnpm run test:tools && pnpm run test:esm",
    "test:coverage": "pnpm -r run test:coverage",
    "test:esm": "node tools/check-esm-entrypoints.mts",
    "test:queue": "node --test build/shared/*.test.mts",
    "test:tools": "node --test tools/*.test.mts",
    "version-packages": "changeset version && pnpm install --lockfile-only && prettier --write --ignore-path=/dev/null \"packages/*/CHANGELOG.md\""
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.1.2",
    "cspell": "^10.0.1",
    "http-server": "^14.1.1",
    "knip": "^6.31.0",
    "markdownlint-cli2": "^0.23.2",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "remark": "^15.0.1",
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-lint-fenced-code-flag": "^4.2.0",
    "remark-preset-lint-consistent": "^6.0.1",
    "remark-preset-lint-recommended": "^7.0.1",
    "remark-preset-prettier": "^2.0.2",
    "remark-validate-links": "^13.1.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^6.0.3",
    "unified": "^11.0.5"
  }
}
