{
  "$schema": "https://typedoc.org/schema.json",
  "plugin": ["typedoc-plugin-markdown"],
  "entryPointStrategy": "packages",
  "entryPoints": [
    "packages/assert",
    "packages/gh-file-importer",
    "packages/util",
    "packages/util-array",
    "packages/util-core",
    "packages/util-errors",
    "packages/util-md-table",
    "packages/util-object",
    "packages/util-text",
    "packages/util-types"
  ],
  "packageOptions": {
    "entryPoints": ["src/index.ts"],
    "tsconfig": "tsconfig.build.json",
    "preservedTypeAnnotationTags": ["@throws"]
  },
  "out": "docs/api",
  "name": "OpenINF",
  "readme": "documentation/api-overview.md",
  "disableSources": true,
  "sanitizeComments": true,
  "navigationJson": "docs/api/navigation.json",
  "cleanOutputDir": true,
  "githubPages": false,

  // The overview links to the generated package index, which TypeDoc reads as
  // a relative file to copy and cannot find, since nothing has generated it
  // yet at that point. It is the only inbound link that page has, and the
  // link is correct in the output, so the check is off rather than the link.
  // `pnpm run docs:check` validates every generated link instead, against the
  // corpus TypeDoc actually wrote.
  "validation": {
    "invalidPath": false
  }
}
